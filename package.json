{
  "name": "@timberframejs/timberframejs",
  "version": "0.0.07",
  "description": "HTML driven reactivity and glue for customElements",
  "author": "Eric Rohlfs",
  "main": "./dist/js/index.js",
  "scripts": {
    "build-docs": "tsc --project tsconfig.json & rolldown --config ./rollup.browser.mjs",
    "build": "tsc --project tsconfig.json & rolldown --config ./rollup.browser.mjs & rolldown --config ./rollup.karma.mjs & terser ./dist/browser/js/index.js -o ./dist/browser/js/index.min.js --compress ecma=2015,computed_props=false",
    "dev": "rolldown --config ./rollup.browser.mjs --watch",
    "test-once": "rolldown --config ./rollup.karma.mjs & rolldown --config ./rollup.browser.mjs",
    "build-test": "rolldown --config ./rollup.karma.mjs --watch",
    "test-dev": "karma start karma.conf.cjs",
    "serve-user-form": "node ./example/user-form/server.js",
    "serve-ping": "node ./example/ping/server.js",
    "minify-browser": "terser ./dist/browser/js/index.js -o ./dist/browser/js/index.min.js --compress ecma=2015,computed_props=false"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/timberframejs/timberframejs.git"
  },
  "license": "MIT",
  "files": [
    "./src",
    "dist/browser/js",
    "dist/js"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.6.3",
    "@eslint/js": "^9.38.0",
    "@types/jasmine": "^4.0.0",
    "@types/node": "^17.0.29",
    "@typescript-eslint/eslint-plugin": "^5.33.0",
    "@typescript-eslint/parser": "^5.33.0",
    "del-cli": "^5.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-custom-elements": "^0.0.6",
    "eslint-plugin-jasmine": "^4.1.3",
    "eslint-plugin-no-unsanitized": "^4.0.1",
    "globals": "^16.4.0",
    "jasmine": "^3.10.0",
    "jasmine-core": "^3.10.1",
    "karma": "^6.4.1",
    "karma-chrome-launcher": "^3.1.0",
    "karma-coverage": "^2.2.0",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^1.7.0",
    "karma-requirejs": "^1.1.0",
    "karma-sinon": "^1.0.5",
    "karma-sourcemap-loader": "^0.3.8",
    "karma-spec-reporter": "^0.0.32",
    "rolldown": "^1.0.0-beta.45",
    "sinon": "^11.1.2",
    "terser": "^5.20.0",
    "ts-node": "^10.9.1",
    "ts-sinon": "^2.0.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.46.2"
  }
}
